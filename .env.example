# PostgreSQL connection string
DATABASE_URL=postgres://lifeos:lifeos@localhost:5432/lifeos

# Allow additional accounts to register after the first one (personal app: keep false)
ALLOW_REGISTRATION=false

# AI (optional). Without a key LifeOS works fully; AI surfaces explain how to enable it.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_PROVIDER=anthropic   # or "fake" for a deterministic offline test provider, or "none"
